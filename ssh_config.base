# Global: must come before any Host block, otherwise it only registers when
# that specific Host is the connection target, leaving it unregistered (and
# UseKeychain fatal) for every other host. See gen_ssh_config.sh for the
# macOS-only filtering of UseKeychain itself.
IgnoreUnknown UseKeychain

# Detect dead connections (e.g. after laptop sleep) instead of hanging in a
# half-broken state — lets the remote side clean up (disable tmux/vim mouse
# tracking, etc.) instead of leaving the local terminal echoing raw mouse
# escape codes on scroll.
Host *
    ServerAliveInterval 30
    ServerAliveCountMax 10

Host github.com
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_rsa
